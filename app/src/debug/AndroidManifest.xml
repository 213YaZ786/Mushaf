<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: checks the speech recogniser from adb. -->
        <activity android:name=".SttCheckActivity" android:exported="true" />
        <!-- Debug builds only: feeds a local APK to the update path; only adb (DUMP) can send to it. -->
        <receiver
            android:name=".DebugUpdateReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
